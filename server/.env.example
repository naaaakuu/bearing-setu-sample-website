# Copy this file to server/.env and fill it in. The file is gitignored.
# Lines starting with # are comments. No quotes needed.

# ---- Basics ---------------------------------------------------------------
# Where the server listens. Many hosts set PORT for you.
PORT=8787
# Use "production" on the real server. In production SECRET is required.
NODE_ENV=production
# Folder for all data (accounts, orders, prices ...). Back this folder up!
# DATA_DIR=./data

# ---- Security -------------------------------------------------------------
# Long random text used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRET=
# Websites allowed to call the API from a browser (comma separated, exact origins).
# Put your storefront address here, e.g. https://www.example.com
CORS_ORIGINS=
# If the server sits behind a proxy or host (Render, Railway, nginx ...) set how many
# proxies are in front of it (normally 1) so rate limits see the real visitor address.
# TRUST_PROXY=1

# ---- Admin login ----------------------------------------------------------
# The admin API and panel stay switched off until both are set.
ADMIN_EMAIL=
# Either a password of at least 10 characters, or (better) the output of:
#   node server/cli.mjs hash-password
ADMIN_PASSWORD=

# ---- Email (SMTP). Leave SMTP_HOST empty to only write emails to DATA_DIR/outbox ----
SMTP_HOST=
SMTP_PORT=587
# true = secure connection from the start (usually port 465). Otherwise STARTTLS is used when offered.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# The "From" address, e.g. orders@example.com or Bearingsetu <orders@example.com>
MAIL_FROM=

# ---- Optional -------------------------------------------------------------
# Public address of the storefront, used for links in emails.
# STOREFRONT_URL=https://www.example.com
# Path to the storefront product catalogue file (default ../assets/js/catalog.js).
# CATALOG_FILE=../assets/js/catalog.js
